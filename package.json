{
  "name": "vscode-db2",
  "displayName": "DB2 SQL",
  "description": "Deep DB2 SQL syntax highlighting for IBM Db2 development in Visual Studio Code.",
  "version": "0.2.0",
  "publisher": "nguyenngocbinh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenngocbinh/vscode-db2.git"
  },
  "homepage": "https://github.com/nguyenngocbinh/vscode-db2",
  "bugs": {
    "url": "https://github.com/nguyenngocbinh/vscode-db2/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "db2",
    "ibm db2",
    "ibm database",
    "sql",
    "database",
    "db2 sql",
    "ibm i",
    "db2 for z/os",
    "db2 for luw"
  ],
  "contributes": {
    "languages": [{
      "id": "db2",
      "aliases": ["DB2", "db2"],
      "extensions": [".db2"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "db2",
      "scopeName": "source.db2",
      "path": "./syntaxes/db2.tmLanguage.json"
    }],
    "snippets": [{
      "language": "db2",
      "path": "./snippets/db2.json"
    }]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "latest"
  }
}
