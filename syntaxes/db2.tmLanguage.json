{
  "name": "DB2 SQL",
  "scopeName": "source.db2",
  "fileTypes": ["db2"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#singleStrings" },
    { "include": "#quotedIdentifiers" },
    { "include": "#parameters" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#special" },
    { "include": "#variables" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.db2", "match": "--.*$" },
        { "name": "comment.block.db2", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "singleStrings": {
      "patterns": [
        {
          "name": "string.quoted.single.db2",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.db2", "match": "''" }
          ]
        },
        { "name": "string.quoted.hex.db2", "match": "\\b(?i:X|GX)'[0-9A-F]*'" }
      ]
    },
    "quotedIdentifiers": {
      "patterns": [
        {
          "name": "variable.other.object.quoted.db2",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            { "name": "constant.character.escape.db2", "match": "\\\"\\\"" }
          ]
        }
      ]
    },
    "parameters": {
      "patterns": [
        { "name": "variable.parameter.db2", "match": "\\?(?:[0-9]+)?" },
        { "name": "variable.parameter.named.db2", "match": "(?<![A-Za-z0-9_$#@]):[A-Za-z_][A-Za-z0-9_$#@]*" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.db2", "match": "(?<![A-Za-z0-9_])(?:[-+]?)(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[Ee][-+]?\\d+)?(?![A-Za-z0-9_])" },
        { "name": "constant.numeric.hex.db2", "match": "\\b0[xX][0-9A-Fa-f]+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.db2",
          "match": "\\b(?i:SELECT|INSERT|UPDATE|DELETE|MERGE|WITH|FROM|WHERE|INTO|VALUES|SET|AS|CASE|WHEN|THEN|ELSE|END|IF|ELSEIF|LOOP|WHILE|REPEAT|FOR|DO|LEAVE|ITERATE|RETURN|BEGIN|ATOMIC|CONTINUE|UNDO|DECLARE|OPEN|FETCH|CLOSE|CALL|SIGNAL|RESIGNAL|GET|DIAGNOSTICS|COMMIT|ROLLBACK|SAVEPOINT|RELEASE|CONNECT|DISCONNECT|PREPARE|EXECUTE|IMMEDIATE|GRANT|REVOKE|LOCK|UNLOCK|EXPLAIN)\\b"
        },
        {
          "name": "keyword.ddl.db2",
          "match": "\\b(?i:CREATE|ALTER|DROP|TRUNCATE|RENAME|REORG|RUNSTATS|COMMENT|REFRESH|REVALIDATE|IMPORT|EXPORT|LOAD|BACKUP|RESTORE)\\b"
        },
        {
          "name": "keyword.object.db2",
          "match": "\\b(?i:TABLE|VIEW|MATERIALIZED|INDEX|ALIAS|SYNONYM|SEQUENCE|NICKNAME|TYPE|DISTINCT|ARRAY|ROW|CURSOR|PROCEDURE|FUNCTION|METHOD|TRIGGER|MODULE|PACKAGE|VARIABLE|ROLE|SCHEMA|DATABASE|TABLESPACE|BUFFERPOOL|STOGROUP|SERVER|WRAPPER|CONSTRAINT|PRIMARY|KEY|FOREIGN|REFERENCES|UNIQUE|CHECK)\\b"
        },
        {
          "name": "keyword.operator.logical.db2",
          "match": "\\b(?i:AND|OR|NOT|IN|IS|NULL|LIKE|ESCAPE|BETWEEN|EXISTS|SOME|ANY|ALL|UNIQUE|DISTINCT)\\b"
        },
        {
          "name": "keyword.order.db2",
          "match": "\\b(?i:ASC|DESC|NULLS|FIRST|LAST)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.db2",
          "match": "\\b(?i:CHAR|CHARACTER|VARCHAR|VARCHAR2|CLOB|DBCLOB|BLOB|GRAPHIC|VARGRAPHIC|LONG\\s+VARCHAR|LONG\\s+VARGRAPHIC|BINARY|VARBINARY|DECIMAL|DEC|NUMERIC|DECFLOAT|INTEGER|INT|BIGINT|SMALLINT|REAL|DOUBLE(?:\\s+PRECISION)?|FLOAT|BOOLEAN|DATE|TIME|TIMESTAMP|XML|ROWID|JSON)\\b"
        },
        {
          "name": "storage.modifier.db2",
          "match": "\\b(?i:FOR\\s+BIT\\s+DATA|NOT\\s+NULL|WITH\\s+DEFAULT|GENERATED|ALWAYS|BY\\s+DEFAULT|IDENTITY|HIDDEN|CCSID|CODEUNITS16|CODEUNITS32|OCTETS|INLINE\\s+LENGTH)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "constant.language.db2",
          "match": "\\b(?i:CURRENT_DATE|CURRENT_TIME|CURRENT_TIMESTAMP|CURRENT_USER|CURRENT_SCHEMA|CURRENT_SERVER|CURRENT_ROLE|CURRENT_PATH|CURRENT_PACKAGE_PATH|CURRENT_TIMEZONE|CURRENT_CLIENT_APPLNAME|CURRENT_CLIENT_USERID|CURRENT_CLIENT_WRKSTNNAME|CURRENT_CLIENT_ACCTNG|TRUE|FALSE|UNKNOWN|DEFAULT)\\b"
        },
        {
          "name": "variable.language.db2",
          "match": "\\b(?i:SQLCODE|SQLSTATE|SQLWARN[0-9]|SQLERRMC|SQLERRD[0-9]|IDENTITY_VAL_LOCAL|ROW_COUNT|RETURNED_SQLSTATE|RETURNED_SQLCODE)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.aggregate.db2",
          "match": "\\b(?i:COUNT|SUM|AVG|MIN|MAX|STDDEV|STDDEV_SAMP|STDDEV_POP|VAR|VARIANCE|VAR_SAMP|VAR_POP|CORR|COVAR_POP|COVAR_SAMP|REGR_SLOPE|REGR_INTERCEPT|REGR_R2|LISTAGG|MEDIAN|PERCENTILE_CONT|PERCENTILE_DISC)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.window.db2",
          "match": "\\b(?i:ROW_NUMBER|RANK|DENSE_RANK|NTILE|LEAD|LAG|FIRST_VALUE|LAST_VALUE|NTH_VALUE|PERCENT_RANK|CUME_DIST)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.string.db2",
          "match": "\\b(?i:SUBSTR|SUBSTRING|TRIM|LTRIM|RTRIM|REPLACE|TRANSLATE|UPPER|LOWER|INITCAP|LENGTH|CHAR_LENGTH|CHARACTER_LENGTH|OCTET_LENGTH|POSSTR|LOCATE|INSTR|LPAD|RPAD|REPEAT|REVERSE|CONCAT|REGEXP_LIKE|REGEXP_REPLACE|REGEXP_SUBSTR|REGEXP_COUNT|SOUNDEX)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.numeric.db2",
          "match": "\\b(?i:ABS|CEILING|CEIL|FLOOR|MOD|POWER|POW|SQRT|EXP|LN|LOG|LOG10|RAND|ROUND|TRUNC|TRUNCATE|SIGN|DEGREES|RADIANS|PI|SIN|COS|TAN|ASIN|ACOS|ATAN|ATAN2|GREATEST|LEAST)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.datetime.db2",
          "match": "\\b(?i:DAYS|MONTHS_BETWEEN|MONTHS|YEARS|MIDNIGHT_SECONDS|DAY|DAYOFMONTH|DAYOFWEEK|DAYOFYEAR|MONTH|QUARTER|WEEK|WEEK_ISO|YEAR|HOUR|MINUTE|SECOND|MICROSECOND|ADD_MONTHS|NEXT_DAY|LAST_DAY|TIMESTAMP_FORMAT|VARCHAR_FORMAT|DATE|TIME|TIMESTAMP)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.null.db2",
          "match": "\\b(?i:COALESCE|NULLIF|NVL|NVL2|VALUE|IFNULL)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.conversion.db2",
          "match": "\\b(?i:CAST|DECIMAL|DOUBLE|INTEGER|BIGINT|SMALLINT|REAL|FLOAT|DECFLOAT|DIGITS|HEX|VARCHAR|CHAR)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.xml.db2",
          "match": "\\b(?i:XMLPARSE|XMLSERIALIZE|XMLCAST|XMLELEMENT|XMLFOREST|XMLCONCAT|XMLDOCUMENT|XMLQUERY|XMLTABLE|XMLVALIDATE|XMLTEXT)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.json.db2",
          "match": "\\b(?i:JSON_OBJECT|JSON_ARRAY|JSON_OBJECTAGG|JSON_ARRAYAGG|JSON_VALUE|JSON_QUERY|JSON_EXISTS|JSON_TYPE|JSON_VALID)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.system.db2",
          "match": "\\b(?i:IDENTITY_VAL_LOCAL|GENERATE_UNIQUE|RID|RID_BIT|HASH4|HASH8|HASH16|HASH20|DECFLOAT)\\b(?=\\s*\\()"
        }
      ]
    },
    "special": {
      "patterns": [
        {
          "name": "keyword.other.isolation.db2",
          "match": "\\b(?i:WITH\\s+(?:UR|CS|RS|RR)|CURRENTLY\\s+COMMITTED|SKIP\\s+LOCKED\\s+DATA|USE\\s+AND\\s+KEEP(?:\\s+(?:UPDATE|SHARE|EXCLUSIVE))?\\s+LOCKS)\\b"
        },
        {
          "name": "keyword.other.fetch.db2",
          "match": "\\b(?i:FETCH\\s+FIRST\\s+\\d+\\s+ROWS?\\s+ONLY|FETCH\\s+NEXT|OFFSET\\s+\\d+\\s+ROWS?|OPTIMIZE\\s+FOR\\s+\\d+\\s+ROWS?)\\b"
        },
        {
          "name": "keyword.other.join.db2",
          "match": "\\b(?i:INNER\\s+JOIN|LEFT(?:\\s+OUTER)?\\s+JOIN|RIGHT(?:\\s+OUTER)?\\s+JOIN|FULL(?:\\s+OUTER)?\\s+JOIN|CROSS\\s+JOIN|LATERAL)\\b"
        },
        {
          "name": "keyword.other.setop.db2",
          "match": "\\b(?i:UNION(?:\\s+ALL)?|INTERSECT(?:\\s+ALL)?|EXCEPT(?:\\s+ALL)?)\\b"
        },
        {
          "name": "keyword.other.window.db2",
          "match": "\\b(?i:OVER|PARTITION\\s+BY|ROWS\\s+BETWEEN|RANGE\\s+BETWEEN|GROUPS\\s+BETWEEN|UNBOUNDED|PRECEDING|FOLLOWING|CURRENT\\s+ROW)\\b"
        },
        {
          "name": "keyword.other.recursive.db2",
          "match": "\\b(?i:WITH\\s+RECURSIVE|SEARCH\\s+(?:DEPTH|BREADTH)\\s+FIRST\\s+BY|CYCLE)\\b"
        },
        {
          "name": "keyword.other.temporal.db2",
          "match": "\\b(?i:FOR\\s+SYSTEM_TIME|FOR\\s+BUSINESS_TIME|AS\\s+OF|FROM\\s+SYSTEM_TIME|FROM\\s+BUSINESS_TIME|PERIOD\\s+SYSTEM_TIME|PERIOD\\s+BUSINESS_TIME|WITHOUT\\s+OVERLAPS|HISTORY\\s+TABLE)\\b"
        },
        {
          "name": "keyword.other.routine.db2",
          "match": "\\b(?i:LANGUAGE\\s+(?:SQL|C|JAVA|CLR)|PARAMETER\\s+STYLE\\s+(?:SQL|GENERAL)|MODIFIES\\s+SQL\\s+DATA|READS\\s+SQL\\s+DATA|CONTAINS\\s+SQL|NO\\s+SQL|DETERMINISTIC|NOT\\s+DETERMINISTIC|NO\\s+EXTERNAL\\s+ACTION|EXTERNAL\\s+ACTION|CALLED\\s+ON\\s+NULL\\s+INPUT|RETURNS\\s+NULL\\s+ON\\s+NULL\\s+INPUT|DYNAMIC\\s+RESULT\\s+SETS|SPECIFIC|FENCED|NOT\\s+FENCED|THREADSAFE|NOT\\s+THREADSAFE|ALLOW\\s+PARALLEL)\\b"
        },
        {
          "name": "keyword.other.identity.db2",
          "match": "\\b(?i:AS\\s+IDENTITY|START\\s+WITH|INCREMENT\\s+BY|MINVALUE|MAXVALUE|CYCLE|NO\\s+CYCLE|CACHE|NO\\s+CACHE|ORDER|NO\\s+ORDER)\\b"
        },
        {
          "name": "keyword.other.constraint.db2",
          "match": "\\b(?i:ON\\s+DELETE|ON\\s+UPDATE|CASCADE|RESTRICT|NO\\s+ACTION|SET\\s+NULL|SET\\s+DEFAULT|DEFERRABLE|NOT\\s+DEFERRABLE|ENFORCED|NOT\\s+ENFORCED|ENABLE|DISABLE)\\b"
        },
        {
          "name": "keyword.other.procedural.db2",
          "match": "\\b(?i:CONTINUE\\s+HANDLER|EXIT\\s+HANDLER|UNDO\\s+HANDLER|HANDLER|SQLWARNING|SQLEXCEPTION|NOT\\s+FOUND|GET\\s+DIAGNOSTICS|STACKED\\s+DIAGNOSTICS|MESSAGE_TEXT|RETURNED_SQLSTATE|DB2_RETURNED_SQLCODE|ROW_COUNT)\\b"
        },
        {
          "name": "keyword.other.temp.db2",
          "match": "\\b(?i:DECLARE\\s+GLOBAL\\s+TEMPORARY|SESSION\\.|ON\\s+COMMIT\\s+(?:DELETE|PRESERVE)\\s+ROWS|NOT\\s+LOGGED|WITH\\s+REPLACE)\\b"
        },
        {
          "name": "keyword.other.merge.db2",
          "match": "\\b(?i:WHEN\\s+MATCHED|WHEN\\s+NOT\\s+MATCHED|MATCHED|NOT\\s+MATCHED)\\b"
        },
        {
          "name": "keyword.other.cursor.db2",
          "match": "\\b(?i:DECLARE\\s+CURSOR|SCROLL|NO\\s+SCROLL|WITH\\s+HOLD|WITHOUT\\s+HOLD|WITH\\s+RETURN|TO\\s+CALLER|TO\\s+CLIENT|FOR\\s+READ\\s+ONLY|FOR\\s+UPDATE)\\b"
        },
        {
          "name": "keyword.other.dynamic.db2",
          "match": "\\b(?i:PREPARE|EXECUTE|EXECUTE\\s+IMMEDIATE|USING|DESCRIPTOR|SQLDA)\\b"
        },
        {
          "name": "keyword.other.admin.db2",
          "match": "\\b(?i:REORG|RUNSTATS|MON_GET|ADMIN_CMD|SNAP_GET|ENV_GET|WLM_GET)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "entity.name.schema.db2", "match": "\\b[A-Za-z_][A-Za-z0-9_$#@]*\\.(?=[A-Za-z_][A-Za-z0-9_$#@]*\\b)" },
        { "name": "variable.other.db2", "match": "(?<![A-Za-z0-9_$#@])[A-Za-z_$#@][A-Za-z0-9_$#@]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.db2", "match": "<>|!=|<=|>=|=|<|>" },
        { "name": "keyword.operator.arithmetic.db2", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.concatenate.db2", "match": "\\|\\|" },
        { "name": "punctuation.separator.comma.db2", "match": "," },
        { "name": "punctuation.terminator.statement.db2", "match": ";" },
        { "name": "punctuation.accessor.db2", "match": "\\." },
        { "name": "punctuation.parenthesis.db2", "match": "[()]" }
      ]
    }
  }
}
